POSTGRES_DB=xiexu
POSTGRES_USER=xiexu
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgres://xiexu:replace-this-local-password@postgres:5432/xiexu
XIEXU_PORT=8080
RUNNER_ID=runner-1
RUNNER_NAME=xiexu-runner

# 真实执行必须完成容器内 Codex 登录；默认受控模式不会启动外部 CLI。
CODEX_EXECUTION_MODE=controlled
CODEX_MAX_RUN_SECONDS=1800

# 仅在使用 deploy/compose.bind.yaml 时设置为宿主机项目目录的绝对路径。
XIEXU_PROJECTS_DIR=/absolute/path/to/projects
